{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "server/**/*.ts",
    "api/**/*.ts",
    "prisma/**/*.ts",
    "prisma.config.ts",
    "tests/server/**/*.ts",
    "scripts/*.ts"
  ]
}
