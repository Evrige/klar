{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run db:generate && npm run build",
  "outputDirectory": "dist",
  "crons": [{"path":"/api/maintenance/expire","schedule":"0 3 * * *"}],
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api?path=:path*"},
    {"source": "/((?!api(?:/|$)).*)", "destination": "/index.html"}
  ],
  "headers": [{"source":"/api/:path*","headers":[{"key":"Cache-Control","value":"private, no-store, max-age=0"}]}]
}
