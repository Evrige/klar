# Server only. Copy to .env; never use VITE_ for secrets.
DATABASE_URL=postgresql://klar:klar_local@127.0.0.1:55432/klar_dev
DATABASE_URL_UNPOOLED=postgresql://klar:klar_local@127.0.0.1:55432/klar_dev
DATABASE_ADAPTER=pg
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-random-at-least-32-character-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CRON_SECRET=
# Registration signs in immediately; no email verification is required.
# mailtrap: Email Sending API; smtp: existing SMTP/Mailpit fallback.
MAIL_PROVIDER=smtp
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=
MAILTRAP_FROM_NAME=Klar
# Optional SMTP. Local Mailpit: host=127.0.0.1, port=1025, from=Klar <no-reply@klar.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Explicitly separate disposable PostgreSQL database for integration tests.
TEST_DATABASE_URL=postgresql://klar:klar_local@127.0.0.1:55432/klar_test
