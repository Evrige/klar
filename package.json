{
  "name": "klar-deutsch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:imports && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "dev:api": "tsx server/dev.ts",
    "check:server": "tsc -p tsconfig.server.json",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:role": "tsx scripts/set-role.ts",
    "db:expire": "tsx scripts/expire-matches.ts",
    "test:server": "tsx --test --test-concurrency=1 tests/server/*.test.ts",
    "db:season": "tsx scripts/create-season.ts",
    "db:prepare:neon": "node scripts/prepare-neon.mjs",
    "build:server": "node scripts/build-server.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/functions": "3.6.1",
    "better-auth": "1.7.14",
    "dotenv": "17.2.3",
    "lucide-react": "^0.468.0",
    "mailtrap": "5.0.0",
    "nodemailer": "10.3.0",
    "pg": "8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "24.10.1",
    "@types/nodemailer": "6.4.24",
    "@types/pg": "8.15.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "0.25.12",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "4.21.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
